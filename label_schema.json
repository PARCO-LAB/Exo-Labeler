  },
  "high_level_labels": [
    {
      "label": "rom_shoulder",
      "definition": "Shoulder range-of-motion tasks performed without external load (posterior reaching, infinity tracing)."
    },
    {
      "label": "rom_trunk",
      "definition": "Trunk range-of-motion tasks performed without external load (lateral bending, axial rotation)."
    },
    {
      "label": "sit_to_stand",
      "definition": "Repeated transitions between standing and sitting on a stool, with or without hand support on the thighs."
    },
    {
      "label": "pouring",
      "definition": "Picking up a bottle, simulating pouring into a set of glasses arranged on a table, and putting the bottle back."
    },
    {
      "label": "drilling",
      "definition": "Picking up a cordless drill, simulating drilling on predefined targets on a horizontal surface or a vertical rack, and putting the drill back."
    },
    {
      "label": "lifting",
      "definition": "Moving an object from the floor to a shelf and back to the floor, with one or two hands."
    },
    {
      "label": "door",
      "definition": "Opening (pull) and closing (push) a cabinet door using its handle."
    },
    {
      "label": "throwing_catching",
      "definition": "Chest pass of a medicine ball to an assistant and catching it when thrown back."
    },
    {
      "label": "curl",
      "definition": "Alternating elbow flexion-extension holding a dumbbell in each hand."
    }
  ],
  "mid_level_labels": [
    {
      "label": "posterior_reach",
      "definition": "One attempt to bring the hands together behind the back, one arm over the shoulder and one from below, and back to the start position."
    },
    {
      "label": "figure_eight",
      "definition": "One complete figure-eight traced in the air with the extended arm."
    },
    {
      "label": "lateral_bend",
      "definition": "One lateral trunk bend sliding the hand down the thigh and return to upright."
    },
    {
      "label": "trunk_twist",
      "definition": "One trunk rotation to one side with arms raised and return to the start position."
    },
    {
      "label": "sit_stand_cycle",
      "definition": "One complete cycle from standing to sitting on the stool and back to standing."
    },
    {
      "label": "pouring_round",
      "definition": "One full pass: picking up the bottle, pouring into all glasses and putting the bottle back."
    },
    {
      "label": "drilling_round",
      "definition": "One full pass: picking up the tool, drilling all targets and putting the tool back."
    },
    {
      "label": "lifting_cycle",
      "definition": "One complete cycle: object moved from the floor to a shelf and back to the floor."
    },
    {
      "label": "door_cycle",
      "definition": "One complete cycle: opening the door and closing it."
    },
    {
      "label": "pass_cycle",
      "definition": "One complete exchange: throwing the ball to the assistant and catching it when thrown back."
    },
    {
      "label": "curl_cycle",
      "definition": "One elbow flexion-extension of the active arm."
    }
  ],
  "low_level_labels": [
    {
      "label": "reach_behind",
      "definition": "Moving the arms from the start position to the position behind the back."
    },
    {
      "label": "hold_behind",
      "definition": "Maintaining the end position behind the back."
    },
    {
      "label": "return_from_behind",
      "definition": "Bringing the arms back from behind the back to the start position."
    },
    {
      "label": "bend_down",
      "definition": "Lateral trunk flexion, from upright to maximum bend."
    },
    {
      "label": "bend_up",
      "definition": "Return from maximum lateral bend to upright."
    },
    {
      "label": "twist_out",
      "definition": "Trunk rotation from the neutral position to maximum rotation."
    },
    {
      "label": "twist_return",
      "definition": "Return from maximum rotation to the neutral position."
    },
    {
      "label": "sit_down",
      "definition": "Descent from standing until stable sitting on the stool."
    },
    {
      "label": "seated",
      "definition": "Pause while sitting on the stool."
    },
    {
      "label": "stand_up",
      "definition": "Rising from the stool until upright standing."
    },
    {
      "label": "bottle_pickup",
      "definition": "Reaching for the bottle on the table and grasping it."
    },
    {
      "label": "pour_glass",
      "definition": "Moving the bottle to one glass and pouring into it."
    },
    {
      "label": "bottle_putdown",
      "definition": "Bringing the bottle back, placing it on the table and releasing it."
    },
    {
      "label": "tool_pickup",
      "definition": "Reaching for the tool and grasping it."
    },
    {
      "label": "drill_target",
      "definition": "Moving the tool to one target, aligning it and drilling."
    },
    {
      "label": "tool_putdown",
      "definition": "Bringing the tool back, placing it and releasing it."
    },
    {
      "label": "lift_to_shelf",
      "definition": "Picking up the object from the floor and placing it on a shelf."
    },
    {
      "label": "lower_to_floor",
      "definition": "Picking up the object from the shelf and placing it on the floor."
    },
    {
      "label": "door_opening",
      "definition": "Grasping the handle and pulling the door open."
    },
    {
      "label": "door_closing",
      "definition": "Grasping the handle and pushing the door closed."
    },
    {
      "label": "ball_throw",
      "definition": "Bringing the ball to the chest and throwing it to the assistant."
    },
    {
      "label": "ball_catch",
      "definition": "Waiting for the ball and catching it."
    },
    {
      "label": "flexion",
      "definition": "Elbow flexion lifting the dumbbell (concentric phase)."
    },
    {
      "label": "extension",
      "definition": "Elbow extension lowering the dumbbell (eccentric phase)."
    }
  ],
  "atomic_labels": [
    {
      "label": "reach",
      "definition": "Hand moves toward an object or target, without load."
    },
    {
      "label": "grasp",
      "definition": "From first contact to stable grip."
    },
    {
      "label": "transport",
      "definition": "Moving the held object."
    },
    {
      "label": "pointing",
      "definition": "Fine alignment of the tool on the drilling location, before contact."
    },
    {
      "label": "press",
      "definition": "Pushing the tool against the drilling location."
    },
    {
      "label": "tilt",
      "definition": "Tilting the bottle over the glass and back."
    },
    {
      "label": "place",
      "definition": "Object is set down."
    },
    {
      "label": "release",
      "definition": "Hand opens and detaches from the object."
    },
    {
      "label": "pull",
      "definition": "Pulling force on the door."
    },
    {
      "label": "push",
      "definition": "Pushing force on the door."
    },
    {
      "label": "throw",
      "definition": "Propulsive phase until ball release."
    },
    {
      "label": "catch",
      "definition": "From first ball contact to end of deceleration."
    },
    {
      "label": "move",
      "definition": "Free movement without a more specific label; specified by 'phase' (e.g. wind_up)."
    },
    {
      "label": "hold",
      "definition": "Maintaining a position; specified by 'phase' (e.g. waiting)."
    },
    {
      "label": "return",
      "definition": "Return to start position without object."
    }
  ],
  "auxiliary_labels": [
    {
      "label": "transition",
      "definition": "Optional: time not belonging to the task (repositioning, adjusting objects)."
    },
    {
      "label": "invalid",
      "definition": "Segment to exclude; reason in 'note' (occlusion, marker loss, EMG artifact, off force plate, wrong execution)."
    }
  ],
  "annotation_record_template": {
    "id": "int",
    "level": "high | mid | low | atomic",
    "label": "string",
    "t_start": "float (s)",
    "t_end": "float (s)",
    "parents": "list of parent record ids (empty for high level)",
    "rep": "int or null",
    "side": "left | right | both | null",
    "direction": "left | right | null",
    "external_load": "none | left | right | both | null",
    "contact_points": "none | left | right | both | null",
    "target": "value from attribute_values.target or null",
    "location": "value from attribute_values.location or null",
    "phase": "string or null",
    "note": "string or null"
  },
