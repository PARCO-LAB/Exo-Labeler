{
  "schema_version": "0.2",
  "description": "Hierarchical label schema for multimodal recordings (Vicon, Aria glasses, EMG, IMU, body-mounted camera, external camera).",
  "conventions": {
    "levels": {
      "high": "Whole set of repetitions of a task.",
      "mid": "One complete repetition of the task (e.g. floor -> shelf -> floor). '_cycle' / movement names = single movement from start position back to start position; '_round' = full pass through multiple targets.",
      "low": "Functional phase inside a repetition (e.g. floor -> shelf).",
      "atomic": "Elementary actions inside a phase (reach, grasp, transport, ...)."
    },
    "optional_levels": "Not every task uses all four levels. When there is no natural subdivision, lower levels are left empty (e.g. no atomic level for ROM, sit-to-stand and curl; no low level for infinity tracing).",
    "parent_policy": {
      "nearest_level": "The parent of a label is the nearest annotated level above it.",
      "multiple_parents": "A label can be linked to more than one parent (e.g. when parents overlap).",
      "bounds": "A child interval normally lies within its parent, but this is not enforced."
    },
    "overlap_policy": "Labels can overlap in time at every level, both with labels of the same type and with different labels. A task normally has one high-level label, but additional overlapping high-level labels are allowed.",
    "contiguity_policy": "Child labels do not have to be contiguous or cover the full parent interval. Uncovered time can stay unlabelled.",
    "typical_order": "The order of 'low' and 'atomic' entries in each task is the typical order, not a strict sequence: labels can overlap, be skipped or leave gaps. 'repeat' marks entries repeated once per target.",
    "attribute_placement": {
      "variant, kg, load_class": "High level (fixed by protocol, inherited by all children).",
      "rep, side, direction": "Mid level (inherited by low and atomic).",
      "target": "Low level (inherited by atomic).",
      "external_load, contact_points": "Lowest annotated level (atomic when present, otherwise low or mid), since they change within a repetition."
    },
    "placeholders": {
      "side": "Resolved with the 'side' attribute annotated for the repetition (left or right)."
    },
    "rep_numbering": "Mid-level repetitions are numbered 1, 2, 3, ... in order of execution. Numbering restarts per side/direction when reps are counted per side/direction. A redone repetition takes the next number; the failed one is marked 'invalid'."
  },
  "attribute_values": {
    "side": [
      "left",
      "right"
    ],
    "direction": [
      "left",
      "right"
    ],
    "external_load": [
      "none",
      "left",
      "right",
      "both"
    ],
    "contact_points": [
      "none",
      "left",
      "right",
      "both"
    ]
  },
  "high_level_labels": [
    {
      "label": "rom_shoulder",
      "definition": "Shoulder range-of-motion tasks performed without external load (posterior reaching, infinity tracing)."
    },
    {
      "label": "rom_trunk",
      "definition": "Trunk range-of-motion tasks performed without external load (lateral bending, axial rotation)."
    },
    {
      "label": "sit_to_stand",
      "definition": "Repeated transitions between standing and sitting on a stool, with or without hand support on the thighs."
    },
    {
      "label": "pouring",
      "definition": "Picking up a bottle, simulating pouring into a set of glasses arranged on a table, and putting the bottle back."
    },
    {
      "label": "drilling",
      "definition": "Picking up a hand tool, simulating drilling on predefined targets on a horizontal surface or a vertical rack, and putting the tool back."
    },
    {
      "label": "lifting",
      "definition": "Moving an object from the floor to a shelf and back to the floor, with one or two hands."
    },
    {
      "label": "door",
      "definition": "Opening (pull) and closing (push) a cabinet door using its handle."
    },
    {
      "label": "throwing_catching",
      "definition": "Chest pass of a medicine ball to an assistant and catching it when thrown back."
    },
    {
      "label": "curl",
      "definition": "Alternating elbow flexion-extension holding a dumbbell in each hand."
    }
  ],
  "mid_level_labels": [
    "posterior_reach",
    "figure_eight",
    "lateral_bend",
    "trunk_twist",
    "sit_stand_cycle",
    "pouring_round",
    "drilling_round",
    "lifting_cycle",
    "door_cycle",
    "pass_cycle",
    "curl_cycle"
  ],
  "low_level_labels": [
    "reach_behind",
    "hold_behind",
    "return_from_behind",
    "bend_down",
    "bend_up",
    "twist_out",
    "twist_return",
    "sit_down",
    "seated",
    "stand_up",
    "bottle_pickup",
    "pour_glass",
    "bottle_putdown",
    "tool_pickup",
    "drill_target",
    "tool_putdown",
    "lift_to_shelf",
    "lower_to_floor",
    "door_opening",
    "door_closing",
    "ball_throw",
    "ball_catch",
    "flexion",
    "extension"
  ],
  "atomic_labels": [
    {
      "label": "reach",
      "definition": "Hand moves toward an object or target, without load."
    },
    {
      "label": "grasp",
      "definition": "From first contact to stable grip."
    },
    {
      "label": "transport",
      "definition": "Moving the held object."
    },
    {
      "label": "pointing",
      "definition": "Fine alignment of the tool on the target, before contact."
    },
    {
      "label": "press",
      "definition": "Pushing the tool against the target."
    },
    {
      "label": "tilt",
      "definition": "Tilting the bottle over the glass and back."
    },
    {
      "label": "place",
      "definition": "Object is set down."
    },
    {
      "label": "release",
      "definition": "Hand opens and detaches from the object."
    },
    {
      "label": "pull",
      "definition": "Pulling force on the door."
    },
    {
      "label": "push",
      "definition": "Pushing force on the door."
    },
    {
      "label": "throw",
      "definition": "Propulsive phase until ball release."
    },
    {
      "label": "catch",
      "definition": "From first ball contact to end of deceleration."
    },
    {
      "label": "move",
      "definition": "Free movement without a more specific label; specified by 'phase' (e.g. wind_up)."
    },
    {
      "label": "hold",
      "definition": "Maintaining a position; specified by 'phase' (e.g. waiting)."
    },
    {
      "label": "return",
      "definition": "Return to start position without object."
    }
  ],
  "auxiliary_labels": [
    {
      "label": "transition",
      "definition": "Optional: time not belonging to the task (repositioning, adjusting objects)."
    },
    {
      "label": "invalid",
      "definition": "Segment to exclude; reason in 'note' (occlusion, marker loss, EMG artifact, off force plate, wrong execution)."
    },
    {
      "label": "sync",
      "definition": "Point event used to align sensor clocks."
    }
  ],
  "annotation_record_template": {
    "id": "int",
    "level": "high | mid | low | atomic",
    "label": "string",
    "t_start": "float (s)",
    "t_end": "float (s)",
    "parents": "list of parent record ids (empty for high level)",
    "rep": "int or null",
    "side": "left | right | null",
    "external_load": "none | left | right | both | null",
    "contact_points": "none | left | right | both | null",
    "target": "string or null",
    "phase": "string or null",
    "note": "string or null"
  },
