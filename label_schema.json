{
  "schema_version": "0.4",
  "description": "Hierarchical label schema for multimodal recordings (Vicon, Aria glasses, EMG, IMU, body-mounted camera, external camera).",
  "conventions": {
    "levels": {
      "high": "Whole set of repetitions of a task.",
      "mid": "One complete repetition of the task (e.g. floor -> shelf -> floor). '_cycle' / movement names = single movement from start position back to start position; '_round' = full pass through multiple locations.",
      "low": "Functional phase inside a repetition (e.g. floor -> shelf).",
      "atomic": "Elementary actions inside a phase (reach, grasp, transport, ...)."
    },
    "optional_levels": "Not every task uses all four levels. When there is no natural subdivision, lower levels are left empty (e.g. no atomic level for ROM, sit-to-stand and curl; no low level for infinity tracing).",
    "parent_policy": {
      "nearest_level": "The parent of a label is the nearest annotated level above it.",
      "multiple_parents": "A label can be linked to more than one parent (e.g. when parents overlap).",
      "bounds": "A child interval normally lies within its parent, but this is not enforced."
    },
    "overlap_policy": "Labels can overlap in time at every level, both with labels of the same type and with different labels. A task normally has one high-level label, but additional overlapping high-level labels are allowed.",
    "contiguity_policy": "Child labels do not have to be contiguous or cover the full parent interval. Uncovered time can stay unlabelled.",
    "typical_order": "The order of 'low' and 'atomic' entries in each task is the typical order, not a strict sequence: labels can overlap, be skipped or leave gaps. 'repeat' marks entries repeated once per location.",
    "side_policy": {
      "levels": "Annotated at mid level by default (inherited); can be refined at low and atomic level.",
      "higher_levels": "When refined, the value at a higher level is the union of the hands used at any time during the interval (e.g. a lifting_cycle where the object is lifted with the right hand and lowered with the left hand has side = both)."
    },
    "load_contact_policy": "external_load and contact_points are annotated only on the lowest annotated level of each task (atomic when present, otherwise low or mid), since they change within a repetition.",
    "attribute_placement": {
      "variant, load_class, kg": "High level (fixed by protocol, inherited by all children).",
      "target": "High level by default (fixed by protocol, inherited); can be overridden at lower levels. Closed vocabulary.",
      "rep": "Mid level (inherited by low and atomic).",
      "side, direction": "Mid level by default (inherited); can be refined at low and atomic level, see 'side_policy'.",
      "location": "Low level (inherited by atomic). Closed vocabulary.",
      "external_load, contact_points": "Lowest annotated level only (atomic when present, otherwise low or mid)."
    },
    "placeholders": {
      "side": "In 'external_load' and 'contact_points', resolved with the 'side' value of the same interval (left, right or both)."
    },
    "rep_numbering": "Mid-level repetitions are numbered 1, 2, 3, ... in order of execution. Numbering restarts per side/direction when reps are counted per side/direction. A redone repetition takes the next number; the failed one is marked 'invalid'."
  },
  "attribute_values": {
    "side": {
      "values": [
        "left",
        "right",
        "both"
      ],
      "definition": "Hand(s) used to handle the target, or the active limb/side for tasks without an object. Allowed values per task in 'side_values'."
    },
    "direction": {
      "values": [
        "left",
        "right"
      ],
      "definition": "Direction of trunk rotation."
    },
    "external_load": {
      "values": [
        "none",
        "left",
        "right",
        "both"
      ],
      "definition": "Hand(s) supporting the mass of the target."
    },
    "contact_points": {
      "values": [
        "none",
        "left",
        "right",
        "both"
      ],
      "definition": "Hand(s) in contact with the target or with a body part used as support (e.g. thighs)."
    },
