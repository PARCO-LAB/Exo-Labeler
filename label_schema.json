{
  "schema_version": "0.1",
  "description": "Hierarchical label schema for multimodal recordings (Vicon, Aria glasses, EMG, IMU, body-mounted camera, external camera).",
  "conventions": {
    "levels": {
      "high": "Segment of one high-level action. A trial can contain one or more high-level labels.",
      "mid": "One repetition linked to one or more high-level segments. '_cycle' / movement names = single movement from start position back to start position; '_round' = sequence through multiple targets.",
      "low": "Atomic action linked to one or more mid-level repetitions."
    },
    "overlap_policy": {
      "high": true,
      "mid": true,
      "low": true,
      "description": "Labels can overlap in time at every level, both with labels of the same type and with different labels (e.g. reach and grasp overlapping during hand pre-shaping, transport and pouring when tilting starts while moving)."
    },
    "contiguity_policy": {
      "required": false,
      "description": "Child labels do not have to be contiguous or cover the full parent interval. Time not covered by any child can stay unlabelled, or be labelled with an auxiliary label if useful."
    },
    "parent_policy": {
      "multiple_parents": true,
      "description": "A child can be linked to more than one parent (e.g. an atomic action falling in two overlapping high-level segments). A child interval normally lies within its parent, but this is not enforced."
    },
    "atomic_sequence": "Typical order of atomic actions in a repetition. It is not a strict sequence: actions can overlap, be skipped or leave gaps between them.",
    "high_level_pattern": {
      "single": "One high-level label covering the whole set of repetitions.",
      "sequential": "Several high-level labels, each covering a block of repetitions, one after the other (they may overlap at the boundaries).",
      "alternating": "Several high-level labels alternating in time (e.g. lifting -> lowering -> lifting ...), possibly overlapping. Each high-level segment contains one mid-level repetition; 'instances' = number of segments with that label in the trial."
    },
    "placeholders": {
      "side": "Resolved with the 'side' attribute annotated for the trial/repetition (left or right)."
    },
    "rules": [
      "External load and contact points are annotated on each atomic action, since they change within a repetition.",
      "The repetition index goes in the 'rep' attribute, not in the label name.",
      "Targets (glass, drilling target, shelf, floor) go in the 'target' attribute of the atomic action."
    ]
  },
  "attribute_values": {
    "side": [
      "left",
      "right"
    ],
    "direction": [
      "left",
      "right"
    ],
    "external_load": [
      "none",
      "left",
      "right",
      "both"
    ],
    "contact_points": [
      "none",
      "left",
      "right",
      "both"
    ]
  },
  "high_level_labels": [
    "rom_shoulder",
    "rom_trunk",
    "sitting",
    "standing",
    "pouring",
    "drilling",
    "lifting",
    "lowering",
    "door_opening",
    "door_closing",
    "throwing",
    "catching",
    "curl"
  ],
  "atomic_actions": [
    {
      "label": "reach",
      "definition": "Hand moves toward an object or target, without load."
    },
    {
      "label": "grasp",
      "definition": "From first contact to stable grip."
    },
    {
      "label": "transport",
      "definition": "Moving the held object."
    },
    {
      "label": "pointing",
      "definition": "Fine alignment of the tool on the target, before contact."
    },
    {
      "label": "drilling",
      "definition": "Pushing the tool against the target."
    },
    {
      "label": "pouring",
      "definition": "Tilting the bottle over the glass and back."
    },
    {
      "label": "place",
      "definition": "Object is set down."
    },
    {
      "label": "release",
      "definition": "Hand opens and detaches from the object."
    },
    {
      "label": "pull",
      "definition": "Pulling force on the door."
    },
    {
      "label": "push",
      "definition": "Pushing force on the door."
    },
    {
      "label": "throw",
      "definition": "Propulsive phase until ball release."
    },
    {
      "label": "catch",
      "definition": "From first ball contact to end of deceleration."
    },
    {
      "label": "move",
      "definition": "Free segmental movement (ROM, sit-to-stand, curl, throw wind-up)."
    },
    {
      "label": "hold",
      "definition": "Maintaining a position."
    },
    {
      "label": "return",
      "definition": "Return to start position without object."
    }
  ],
  "auxiliary_labels": [
    {
      "label": "transition",
      "definition": "Optional: time not belonging to the task (repositioning, adjusting objects)."
    },
    {
      "label": "invalid",
      "definition": "Segment to exclude; reason in 'note' (occlusion, marker loss, EMG artifact, off force plate, wrong execution)."
    },
    {
      "label": "sync",
      "definition": "Point event used to align sensor clocks."
    }
  ],
  "annotation_record_template": {
    "id": "int",
    "level": "high | mid | low",
    "label": "string",
    "t_start": "float (s)",
    "t_end": "float (s)",
    "parents": "list of parent record ids (empty for high level)",
    "rep": "int or null",
    "side": "left | right | null",
    "external_load": "none | left | right | both | null",
    "contact_points": "none | left | right | both | null",
    "target": "string or null",
    "note": "string or null"
  },
